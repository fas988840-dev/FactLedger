{
  "name": "factledger",
  "version": "0.1.0",
  "description": "FactLedger: a read-only Solana wallet intelligence platform with transaction parsing and risk analysis",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "mcp": "tsx src/mcp/index.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "verify:solana": "node scripts/verify-solana-rpc-ws.mjs",
    "monitor:daily": "node scripts/daily-funding-email-monitor.mjs",
    "mcp:100-agents": "node scripts/mcp-100-agents-runner.mjs",
    "reports:100": "node scripts/generate-100-reports-and-revenue-plan.mjs",
    "monitor:server": "node scripts/funding-live-dashboard-server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/web3.js": "^1.91.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "ws": "^8.18.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/ui": "^5.0.5",
    "eslint": "^8.56.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@solana/web3.js": {
      "jayson": "5.0.0"
    }
  }
}
